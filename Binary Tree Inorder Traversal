1.) Optimal solution



class Solution {
public:
    vector<int> inorderTraversal(TreeNode* root) {
        vector<int> ans;
        TreeNode* curr = root;

        while(curr != NULL){
            if(curr->left == NULL){
                ans.push_back(curr->val);
                curr = curr->right;
            }else{
                //find the IP
                TreeNode* IP = curr->left;
                while(IP->right != NULL && IP->right != curr){
                    IP = IP->right;
                }

                if(IP->right == NULL){
                    IP->right = curr;   //CREATE
                    curr = curr->left;
                }else{
                    IP->right = NULL;
                    ans.push_back(curr->val);  //DESTROY
                    curr = curr->right;
                }
            }
        }
        return ans;
    }
};



2.) Brute-Force Approach


#include <iostream>
#include <vector>
using namespace std;

struct TreeNode {
    int val;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int x) {
        val = x;
        left = nullptr;
        right = nullptr;
    }
};

void inorder(TreeNode* root, vector<int>& result) {
    // Base case
    if (root == nullptr) {
        return;
    }

    // 1. Left
    inorder(root->left, result);

    // 2. Root
    result.push_back(root->val);

    // 3. Right
    inorder(root->right, result);
}

vector<int> inorderTraversal(TreeNode* root) {
    vector<int> result;

    inorder(root, result);

    return result;
}
