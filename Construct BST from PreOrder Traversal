1.) Optimal solution



class Solution {
public:
    TreeNode* helper(vector<int>& preorder, int &i, int bound){
        if(i >= preorder.size() || preorder[i] > bound){
            return NULL;
        }

        TreeNode* root = new TreeNode(preorder[i++]);
        root->left = helper(preorder, i, root->val);
        root->right = helper(preorder, i, bound);

        return root;
    }

    TreeNode* bstFromPreorder(vector<int>& preorder) {
        int i = 0;
        return helper(preorder, i, INT_MAX);
    }
};





2.) Brute-Force approach




#include <iostream>
#include <vector>
#include <queue>
#include <climits>
using namespace std;

struct TreeNode {
    int val;
    TreeNode* left;
    TreeNode* right;

    TreeNode(int x) {
        val = x;
        left = nullptr;
        right = nullptr;
    }
};

TreeNode* buildTree(vector<int>& preorder, int& index,
                    long long minValue, long long maxValue) {

    if (index == preorder.size()) {
        return nullptr;
    }

    if (preorder[index] <= minValue ||
        preorder[index] >= maxValue) {
        return nullptr;
    }

    TreeNode* root = new TreeNode(preorder[index]);
    index++;

    // LEFT
    root->left = buildTree(preorder, index,
                           minValue, root->val);

    // RIGHT
    root->right = buildTree(preorder, index,
                            root->val, maxValue);

    return root;
}

TreeNode* bstFromPreorder(vector<int>& preorder) {

    int index = 0;

    return buildTree(preorder, index,
                     LLONG_MIN, LLONG_MAX);
}

// Print tree in LeetCode format
void printTree(TreeNode* root) {

    if (root == nullptr) {
        cout << "[]";
        return;
    }

    queue<TreeNode*> q;
    q.push(root);

    vector<string> result;

    while (!q.empty()) {

        TreeNode* current = q.front();
        q.pop();

        if (current == nullptr) {
            result.push_back("null");
        }
        else {
            result.push_back(to_string(current->val));

            q.push(current->left);
            q.push(current->right);
        }
    }

    // Remove extra null values at the end
    while (!result.empty() && result.back() == "null") {
        result.pop_back();
    }

    cout << "[";

    for (int i = 0; i < result.size(); i++) {

        cout << result[i];

        if (i != result.size() - 1) {
            cout << ",";
        }
    }

    cout << "]";
}

int main() {

    vector<int> preorder = {1, 3};

    TreeNode* root = bstFromPreorder(preorder);

    cout << "Input: preorder = [1, 3]" << endl;

    cout << "Output: ";
    printTree(root);

    return 0;
}
