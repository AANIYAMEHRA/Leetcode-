Given an array of integers nums containing n + 1 integers where each integer is in the range [1, n] inclusive.
There is only one repeated number in nums, return this repeated number.
You must solve the problem without modifying the array nums and using only constant extra space.




Example 1:

Input: nums = [1,3,4,2,2]
Output: 2




Example 2:

Input: nums = [3,1,3,4,2]
Output: 3




Example 3:

Input: nums = [3,3,3,3,3]
Output: 3





CODE  //




#include <iostream>
#include <vector>
using namespace std;

int findDuplicate(vector<int>& nums) {
    // Step 1: Find intersection point
    int slow = nums[0];
    int fast = nums[0];

    do {
        slow = nums[slow];
        fast = nums[nums[fast]];
    } while (slow != fast);

    // Step 2: Find entrance of the cycle
    slow = nums[0];

    while (slow != fast) {
        slow = nums[slow];
        fast = nums[fast];
    }

    return slow;
}



int main()
{
    
    vector<int> nums = {1, 3, 4, 2, 2};

    cout << "Repeated number: " << findDuplicate(nums);

    return 0;
}




Extension
Now to solve the problem for the all the repeated numbers present insde the input array.



#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

int main() {
    vector<int> nums = {1, 3, 4, 2, 2, 3};

    unordered_map<int, int> freq;

    cout << "Repeated numbers: ";

    for (int num : nums) {
        freq[num]++;
    }

    for (auto x : freq) {
        if (x.second > 1) {
            cout << x.first << " ";
        }
    }

    return 0;
}



